# App
APP_NAME="Personalized Holiday Management Agent"
APP_ENV="dev"

# Free model defaults via local Ollama (OpenAI-compatible API)
LLM_MODEL="llama3.2:3b"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_TEMPERATURE=0.2

# Agent runtime
MAX_ROUND_MESSAGES=10
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT="holiday-agent/1.0 (local dev)"
